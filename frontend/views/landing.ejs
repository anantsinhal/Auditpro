<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <script>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
          return;
        }
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {
        // ignore
      }
    })();
  </script>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000&display=swap" rel="stylesheet">
  <script src="/js/main.js" defer></script>
  <style>
    /*
      Home page theme support
      - Theme is controlled by `html[data-theme]` (set in <head> + /js/main.js)
      - We keep overrides here so the toggle affects the home screen without
        requiring a global Tailwind rebuild.
    */
    html[data-theme="dark"] {
      color-scheme: dark;
    }

    /* Minimal mapping for the Tailwind utility classes used on this page */
    html[data-theme="dark"] .bg-slate-50 { background-color: var(--color-slate-900); }
    html[data-theme="dark"] .bg-slate-100 { background-color: var(--color-slate-800); }
    html[data-theme="dark"] .bg-slate-200 { background-color: var(--color-slate-700); }
    html[data-theme="dark"] .bg-white { background-color: var(--color-slate-800); }
    html[data-theme="dark"] .bg-white\/80 { background-color: color-mix(in oklab, var(--color-slate-800) 80%, transparent); }
    html[data-theme="dark"] .bg-white\/90 { background-color: color-mix(in oklab, var(--color-slate-800) 90%, transparent); }

    html[data-theme="dark"] .text-slate-900 { color: var(--color-slate-50); }
    html[data-theme="dark"] .text-slate-800 { color: var(--color-slate-100); }
    html[data-theme="dark"] .text-slate-700 { color: var(--color-slate-200); }
    html[data-theme="dark"] .text-slate-600 { color: var(--color-slate-300); }
    html[data-theme="dark"] .text-slate-500 { color: var(--color-slate-400); }
    html[data-theme="dark"] .text-slate-400 { color: var(--color-slate-500); }

    html[data-theme="dark"] .border-slate-100 { border-color: var(--color-slate-800); }
    html[data-theme="dark"] .border-slate-200 { border-color: var(--color-slate-700); }
    html[data-theme="dark"] .border-slate-200\/60 { border-color: color-mix(in oklab, var(--color-slate-700) 60%, transparent); }
    html[data-theme="dark"] .border-slate-200\/80 { border-color: color-mix(in oklab, var(--color-slate-700) 80%, transparent); }

    /* Landing-only components */
    html[data-theme="dark"] .hero-gradient {
      background: linear-gradient(160deg, var(--color-slate-900) 0%, var(--color-slate-800) 35%, var(--color-indigo-900) 60%, var(--color-slate-900) 100%);
    }
    html[data-theme="dark"] .stat-card {
      background: color-mix(in oklab, var(--color-slate-800) 85%, transparent);
    }

    .hero-gradient {
      background: linear-gradient(160deg, #f8fafc 0%, #e0e7ff 30%, #ede9fe 50%, #ddd6fe 70%, #f8fafc 100%);
    }
    .float-anim { animation: float 6s ease-in-out infinite; }
    .float-delay { animation: float 6s ease-in-out infinite; animation-delay: -3s; }
    @keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-12px); } }
    .fade-in { animation: fadeUp 0.6s ease-out forwards; opacity: 0; }
    .fd1 { animation-delay: 0.1s; } .fd2 { animation-delay: 0.2s; } .fd3 { animation-delay: 0.3s; } .fd4 { animation-delay: 0.4s; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .feature-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px -12px rgba(99,102,241,0.15); border-color: #c7d2fe; }
    .stat-card { background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px -8px rgba(99,102,241,0.12); }
    .hero-cta { background: linear-gradient(135deg, #6366f1 0%, #7c3aed 50%, #6366f1 100%); background-size: 200% 200%; animation: shimmer 3s ease-in-out infinite; }
    @keyframes shimmer { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
  <%- include('partials/header') %>
  <main class="flex-1">

    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden">
      <!-- Background blobs -->
      <div class="absolute top-10 left-20 w-96 h-96 bg-indigo-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 float-anim"></div>
      <div class="absolute top-40 right-10 w-80 h-80 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-25 float-delay"></div>
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-violet-200 rounded-full mix-blend-multiply filter blur-3xl opacity-15 float-anim"></div>

      <div class="max-w-5xl mx-auto px-4 py-20 md:py-28 lg:py-32 text-center relative z-10">
        <div class="fade-in">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/90 backdrop-blur-sm border border-indigo-200/60 text-indigo-700 rounded-full text-sm font-semibold mb-8 shadow-sm">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
            </span>
            AI-Powered SEO Analysis
          </span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-slate-900 mb-6 leading-[1.1] tracking-tight fade-in fd1">
          Audit, Analyze &amp;<br>
          <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-violet-600 bg-clip-text text-transparent">Outrank Your Competition</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 mb-10 max-w-2xl mx-auto leading-relaxed fade-in fd2">
          Get instant SEO scores, AI-generated fix recommendations, PageSpeed insights, and competitor comparisons — all in one click.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-in fd3">
          <% if (user) { %>
            <a href="/audit" class="hero-cta inline-flex items-center gap-2 text-white px-8 py-4 rounded-2xl text-lg font-semibold shadow-lg shadow-indigo-300/40 hover:shadow-xl hover:shadow-indigo-400/40 transition-all hover:scale-[1.02]">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
              Run an Audit
            </a>
            <a href="/dashboard" class="inline-flex items-center gap-2 bg-white text-slate-700 px-8 py-4 rounded-2xl text-lg font-semibold border-2 border-slate-200 hover:border-indigo-300 hover:text-indigo-700 hover:bg-indigo-50/50 transition-all shadow-sm">
              Go to Dashboard <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          <% } else { %>
            <a href="/register" class="hero-cta inline-flex items-center gap-2 text-white px-8 py-4 rounded-2xl text-lg font-semibold shadow-lg shadow-indigo-300/40 hover:shadow-xl hover:shadow-indigo-400/40 transition-all hover:scale-[1.02]">
              Get Started Free <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
            <a href="/login" class="inline-flex items-center gap-2 bg-white text-slate-700 px-8 py-4 rounded-2xl text-lg font-semibold border-2 border-slate-200 hover:border-indigo-300 hover:text-indigo-700 hover:bg-indigo-50/50 transition-all shadow-sm">Sign in</a>
          <% } %>
        </div>

        <!-- Stat Cards -->
        <div class="grid grid-cols-3 gap-4 sm:gap-6 max-w-md sm:max-w-lg mx-auto mt-16 md:mt-20 fade-in fd4">
          <div class="stat-card rounded-2xl p-4 sm:p-5 border border-indigo-100/60 shadow-sm transition-all duration-300">
            <p class="text-3xl sm:text-4xl font-extrabold bg-gradient-to-br from-indigo-600 to-purple-600 bg-clip-text text-transparent">50+</p>
            <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">SEO Checks</p>
          </div>
          <div class="stat-card rounded-2xl p-4 sm:p-5 border border-purple-100/60 shadow-sm transition-all duration-300">
            <p class="text-3xl sm:text-4xl font-extrabold bg-gradient-to-br from-purple-600 to-violet-600 bg-clip-text text-transparent">AI</p>
            <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">Fix Suggestions</p>
          </div>
          <div class="stat-card rounded-2xl p-4 sm:p-5 border border-violet-100/60 shadow-sm transition-all duration-300">
            <p class="text-3xl sm:text-4xl font-extrabold bg-gradient-to-br from-violet-600 to-indigo-600 bg-clip-text text-transparent">&lt;30s</p>
            <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">Full Report</p>
          </div>
        </div>

        <!-- Trusted by badge -->
        <p class="text-xs text-slate-400 mt-8 fade-in fd4">No credit card required · <%= Number.isFinite(freePlan?.monthlyAudits) ? freePlan.monthlyAudits : 'Unlimited' %> free audits/month</p>
      </div>
    </section>

    <!-- Features -->
    <section class="max-w-5xl mx-auto px-4 py-20 md:py-24">
      <div class="text-center mb-14">
        <span class="inline-block px-4 py-1.5 bg-indigo-50 text-indigo-600 rounded-full text-sm font-semibold mb-4 border border-indigo-100">Features</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Everything you need to rank higher</h2>
        <p class="text-slate-500 max-w-xl mx-auto text-base">Comprehensive tools to audit, track, and improve your website's search engine performance.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        <div class="feature-card bg-white p-7 rounded-2xl border border-slate-200/80 transition-all duration-300 cursor-default group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 flex items-center justify-center mb-5 shadow-lg shadow-indigo-200/50 group-hover:shadow-indigo-300/60 transition-shadow">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Deep SEO Audit</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Title tags, meta descriptions, headings, schema markup, Open Graph, broken links, and 40+ more checks.</p>
        </div>
        <div class="feature-card bg-white p-7 rounded-2xl border border-slate-200/80 transition-all duration-300 cursor-default group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center mb-5 shadow-lg shadow-purple-200/50 group-hover:shadow-purple-300/60 transition-shadow">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">PageSpeed Insights</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Core Web Vitals, performance scores, and optimization opportunities pulled from Google Lighthouse.</p>
        </div>
        <div class="feature-card bg-white p-7 rounded-2xl border border-slate-200/80 transition-all duration-300 cursor-default group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center mb-5 shadow-lg shadow-amber-200/50 group-hover:shadow-amber-300/60 transition-shadow">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">AI Recommendations</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Get an AI-generated action plan with optimised meta tags, keyword suggestions, and internal linking tips.</p>
        </div>
        <div class="feature-card bg-white p-7 rounded-2xl border border-slate-200/80 transition-all duration-300 cursor-default group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-rose-500 to-red-500 flex items-center justify-center mb-5 shadow-lg shadow-rose-200/50 group-hover:shadow-rose-300/60 transition-shadow">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Competitor Compare</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Run side-by-side audits against any competitor. See exactly where you win and where you need to improve.</p>
        </div>
        <div class="feature-card bg-white p-7 rounded-2xl border border-slate-200/80 transition-all duration-300 cursor-default group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-green-500 flex items-center justify-center mb-5 shadow-lg shadow-emerald-200/50 group-hover:shadow-emerald-300/60 transition-shadow">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Rank Tracking</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Monitor your keyword positions across Google. Track gains and drops with position change indicators.</p>
        </div>
        <div class="feature-card bg-white p-7 rounded-2xl border border-slate-200/80 transition-all duration-300 cursor-default group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-500 flex items-center justify-center mb-5 shadow-lg shadow-teal-200/50 group-hover:shadow-teal-300/60 transition-shadow">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Local Business Audit</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Specialised audits for restaurants &amp; cafés with review analysis, menu suggestions, and a 30-day action plan.</p>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="bg-white border-y border-slate-100">
      <div class="max-w-5xl mx-auto px-4 py-20 md:py-24">
        <div class="text-center mb-14">
          <span class="inline-block px-4 py-1.5 bg-purple-50 text-purple-600 rounded-full text-sm font-semibold mb-4 border border-purple-100">How it works</span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Three steps to better rankings</h2>
          <p class="text-slate-500 max-w-md mx-auto">No setup required. Just paste a URL and get actionable results in seconds.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8 md:gap-10">
          <div class="text-center group">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-2xl font-bold flex items-center justify-center mx-auto mb-5 shadow-xl shadow-indigo-200/60 group-hover:shadow-indigo-300/70 group-hover:scale-105 transition-all">1</div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Enter your URL</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Paste any website URL and hit audit. That's it — no setup required.</p>
          </div>
          <div class="text-center group">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-2xl font-bold flex items-center justify-center mx-auto mb-5 shadow-xl shadow-indigo-200/60 group-hover:shadow-indigo-300/70 group-hover:scale-105 transition-all">2</div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Get your report</h3>
            <p class="text-sm text-slate-500 leading-relaxed">In under 30 seconds, receive a scored report with categorised issues and AI suggestions.</p>
          </div>
          <div class="text-center group">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-2xl font-bold flex items-center justify-center mx-auto mb-5 shadow-xl shadow-indigo-200/60 group-hover:shadow-indigo-300/70 group-hover:scale-105 transition-all">3</div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Fix &amp; improve</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Follow the action plan, apply the fixes, and watch your rankings climb.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-5xl mx-auto px-4 py-20 md:py-24 text-center">
      <div class="bg-gradient-to-br from-indigo-600 via-purple-600 to-violet-700 rounded-3xl p-12 md:p-16 relative overflow-hidden shadow-2xl shadow-indigo-200/40">
        <div class="absolute top-0 right-0 w-80 h-80 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/3 blur-2xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full translate-y-1/3 -translate-x-1/4 blur-xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl"></div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white mb-5 leading-tight">Ready to improve your SEO?</h2>
          <p class="text-indigo-100 mb-10 text-lg max-w-xl mx-auto leading-relaxed">Start with <%= Number.isFinite(freePlan?.monthlyAudits) ? freePlan.monthlyAudits : 'unlimited' %> free audits per month. Upgrade to Pro for unlimited audits, scheduled monitoring, API access, and more.</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <% if (user) { %>
              <a href="/audit" class="bg-white text-indigo-700 px-8 py-4 rounded-2xl text-lg font-bold hover:bg-indigo-50 transition-all shadow-lg hover:shadow-xl hover:scale-[1.02]">Run an Audit</a>
            <% } else { %>
              <a href="/register" class="bg-white text-indigo-700 px-8 py-4 rounded-2xl text-lg font-bold hover:bg-indigo-50 transition-all shadow-lg hover:shadow-xl hover:scale-[1.02]">Get Started Free</a>
            <% } %>
            <a href="/pricing" class="text-white/90 hover:text-white font-semibold flex items-center gap-1.5 transition-colors text-lg">View pricing <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <%- include('partials/footer') %>
</body>
</html>
