<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .section-card { background-color: white; border-radius: 1rem; box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); border: 1px solid #e2e8f0; padding: 1.5rem; margin-bottom: 1.5rem; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="max-w-3xl mx-auto px-4 py-10 flex-1">
    <div class="mb-6">
      <a href="/dashboard" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        Back to dashboard
      </a>
    </div>

    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-amber-200">
        <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
      </div>
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-amber-100 text-amber-800 px-3 py-1 rounded-full mb-3">🍽️ Restaurant & Café Audit</span>
      <h1 class="text-2xl font-bold text-slate-900">Local Business Growth Audit</h1>
      <p class="text-slate-500 mt-1 text-sm">Enter your restaurant's details below. The more you fill in, the more detailed your report.</p>
    </div>

    <form action="/local-audit" method="POST" class="space-y-6">

      <!-- ── SECTION 1: Your Restaurant ── -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-xs font-bold flex items-center justify-center shadow-sm">1</span>
          <h2 class="font-semibold text-slate-900">Your Restaurant Details</h2>
        </div>
        <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-slate-700 mb-1">Restaurant Name <span class="text-red-500">*</span></label>
            <input type="text" name="restaurantName" required placeholder="e.g. Bella Cucina" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Website URL</label>
            <input type="url" name="url" placeholder="https://bellacucina.com" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">City / Town <span class="text-red-500">*</span></label>
            <input type="text" name="city" required placeholder="e.g. Manchester" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Google Rating <span class="text-slate-400 font-normal">(e.g. 4.2)</span></label>
            <input type="number" name="googleRating" step="0.1" min="1" max="5" placeholder="4.2" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Number of Google Reviews</label>
            <input type="number" name="reviewCount" min="0" placeholder="47" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Page Load Speed <span class="text-slate-400 font-normal">(seconds, e.g. 2.4)</span></label>
            <input type="number" name="pageSpeed" step="0.1" min="0" placeholder="2.4" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Homepage Word Count <span class="text-slate-400 font-normal">(approx)</span></label>
            <input type="number" name="wordCount" min="0" placeholder="250" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Schema Markup present?</label>
            <select name="hasSchema" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 text-sm bg-slate-50 focus:bg-white transition-colors">
              <option value="no">No / Don't know</option>
              <option value="yes">Yes</option>
            </select>
          </div>
        </div>
      </div>

      <!-- ── SECTION 2: Meta Tags ── -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-xs font-bold flex items-center justify-center shadow-sm">2</span>
          <h2 class="font-semibold text-slate-900">Meta Tags & Headings <span class="text-slate-400 text-sm font-normal">(view source or use browser DevTools)</span></h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Current Page Title Tag</label>
            <input type="text" name="metaTitle" placeholder="e.g. Bella Cucina – Italian Restaurant" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Current Meta Description</label>
            <textarea name="metaDescription" rows="2" placeholder="e.g. Authentic Italian food in the heart of Manchester..." class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm resize-none"></textarea>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">H1 Heading on Homepage</label>
              <input type="text" name="h1" placeholder="e.g. Welcome to Bella Cucina" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">H2 Heading (optional)</label>
              <input type="text" name="h2" placeholder="e.g. Our Menu" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
            </div>
          </div>
        </div>
      </div>

      <!-- ── SECTION 3: Competitor ── -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-xs font-bold flex items-center justify-center shadow-sm">3</span>
          <h2 class="font-semibold text-slate-900">Competitor Data <span class="text-slate-400 text-sm font-normal">(optional but recommended)</span></h2>
        </div>
        <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-slate-700 mb-1">Competitor Restaurant Name</label>
            <input type="text" name="compName" placeholder="e.g. Napoli Express" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Competitor Google Rating</label>
            <input type="number" name="compRating" step="0.1" min="1" max="5" placeholder="4.6" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Competitor Review Count</label>
            <input type="number" name="compReviewCount" min="0" placeholder="210" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Competitor Page Speed (s)</label>
            <input type="number" name="compPageSpeed" step="0.1" min="0" placeholder="1.8" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Competitor Word Count</label>
            <input type="number" name="compWordCount" min="0" placeholder="450" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Competitor Title Tag</label>
            <input type="text" name="compMetaTitle" placeholder="e.g. Napoli Express | Best Italian in Manchester" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Competitor Schema Markup?</label>
            <select name="compHasSchema" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 text-sm bg-slate-50 focus:bg-white transition-colors">
              <option value="no">No / Don't know</option>
              <option value="yes">Yes</option>
            </select>
          </div>
        </div>
      </div>

      <!-- ── SECTION 4: Menu & Reviews ── -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-xs font-bold flex items-center justify-center shadow-sm">4</span>
          <h2 class="font-semibold text-slate-900">Menu & Customer Reviews <span class="text-slate-400 text-sm font-normal">(optional)</span></h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Current Menu Items <span class="text-slate-400 font-normal">(comma-separated or list)</span></label>
            <textarea name="menuItems" rows="3" placeholder="e.g. Margherita Pizza, Spaghetti Carbonara, Tiramisu, Garlic Bread, Risotto..." class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm resize-none"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Sample Customer Reviews <span class="text-slate-400 font-normal">(paste 3–10 reviews, separate with blank line or ---)</span></label>
            <textarea name="sampleReviews" rows="6" placeholder="Great food and friendly staff! The pasta was delicious.
---
The wait was too long and the food came out cold.
---
Best Italian in Manchester. Highly recommend the tiramisu!" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-colors text-sm resize-none font-mono text-xs"></textarea>
          </div>
        </div>
      </div>

      <!-- Submit -->
      <div class="flex items-center gap-4">
        <button type="submit" class="flex-1 sm:flex-none bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-8 py-3.5 rounded-xl font-semibold text-sm transition-all shadow-sm hover:shadow-md flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Generate Growth Report
        </button>
        <a href="/dashboard" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
      </div>
    </form>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
