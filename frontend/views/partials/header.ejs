<script>
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') {
        document.documentElement.setAttribute('data-theme', stored);
        return;
      }
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    } catch (e) {
      // ignore
    }
  })();
</script>

<script src="/js/main.js" defer></script>

<header class="bg-white/80 backdrop-blur-md border-b border-slate-200/60 sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-sm group-hover:shadow-md transition-shadow">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
      <span class="text-xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">AuditPro</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-1">
      <% if (typeof showThemeToggle === 'undefined' || showThemeToggle) { %>
        <button
          type="button"
          data-theme-toggle
          class="mr-2 inline-flex items-center justify-center p-2 rounded-lg bg-slate-50 border border-slate-200 text-slate-600 hover:bg-slate-100 transition-colors"
          aria-label="Toggle theme"
          aria-pressed="false"
        >
          <!-- Moon (switch to dark) -->
          <svg data-theme-icon="moon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z" />
          </svg>
          <!-- Sun (switch to light) -->
          <svg data-theme-icon="sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a6 6 0 100-12 6 6 0 000 12z" />
          </svg>
        </button>
      <% } %>

      <% if (typeof user !== 'undefined' && user) { %>
        <% const _displayName = (function () { try { var n = String(user.name || '').trim(); return n ? (n.charAt(0).toUpperCase() + n.slice(1)) : 'User'; } catch (e) { return 'User'; } })(); %>
        <a href="/dashboard" class="px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all font-medium">Dashboard</a>
        <a href="/compare" class="px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all font-medium">Compare</a>
        <a href="/scheduled-audits" class="px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all font-medium">Schedules</a>
        <a href="/pricing" class="px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all font-medium">Pricing</a>
        <a href="/settings" class="px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all font-medium">Settings</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="px-3 py-2 text-sm text-red-600 hover:text-red-700 hover:bg-red-50 rounded-lg transition-all font-medium">Admin</a>
        <% } %>
        <div class="h-5 w-px bg-slate-200 mx-2"></div>
        <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-50 rounded-lg">
          <div class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 flex items-center justify-center text-white text-xs font-bold">
            <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
          </div>
          <span class="text-sm font-medium text-slate-700"><%= _displayName %></span>
          <span class="text-xs px-2 py-0.5 rounded-full font-medium <%= user.plan === 'pro' ? 'bg-gradient-to-r from-amber-100 to-orange-100 text-amber-800 border border-amber-200' : 'bg-slate-100 text-slate-500 border border-slate-200' %>"><%= user.plan === 'pro' ? '⭐ Pro' : 'Free' %></span>
        </div>
        <a href="/logout" class="ml-1 px-3 py-2 text-sm text-slate-400 hover:text-red-500 rounded-lg transition-all" title="Log out">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
        </a>
      <% } else { %>
        <a href="/pricing" class="px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all font-medium">Pricing</a>
        <a href="/login" class="px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all font-medium">Log in</a>
        <a href="/register" class="ml-1 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition-all shadow-sm hover:shadow-md">Sign up free</a>
      <% } %>
    </div>

    <!-- Mobile Hamburger -->
    <button onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" class="md:hidden p-2 rounded-lg text-slate-500 hover:bg-slate-100 transition-colors">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 pb-4 pt-2 space-y-1">
    <% if (typeof showThemeToggle === 'undefined' || showThemeToggle) { %>
      <button
        type="button"
        data-theme-toggle
        class="w-full flex items-center justify-between px-3 py-2 text-sm bg-slate-50 border border-slate-200 text-slate-700 rounded-lg"
        aria-label="Toggle theme"
        aria-pressed="false"
      >
        <span class="font-medium">Theme</span>
        <span class="flex items-center gap-2">
          <svg data-theme-icon="moon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z" />
          </svg>
          <svg data-theme-icon="sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a6 6 0 100-12 6 6 0 000 12z" />
          </svg>
        </span>
      </button>
    <% } %>

    <% if (typeof user !== 'undefined' && user) { %>
      <% const _displayNameMobile = (function () { try { var n = String(user.name || '').trim(); return n ? (n.charAt(0).toUpperCase() + n.slice(1)) : 'User'; } catch (e) { return 'User'; } })(); %>
      <div class="flex items-center gap-2 px-3 py-2 mb-2">
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 flex items-center justify-center text-white text-sm font-bold">
          <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div>
          <p class="text-sm font-medium text-slate-800"><%= _displayNameMobile %></p>
          <span class="text-xs px-1.5 py-0.5 rounded-full <%= user.plan === 'pro' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-500' %>"><%= user.plan %></span>
        </div>
      </div>
      <a href="/dashboard" class="block px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg">Dashboard</a>
      <a href="/compare" class="block px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg">Compare</a>
      <a href="/scheduled-audits" class="block px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg">Schedules</a>
      <a href="/pricing" class="block px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg">Pricing</a>
      <a href="/settings" class="block px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg">Settings</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin" class="block px-3 py-2 text-sm text-red-600 hover:text-red-700 hover:bg-red-50 rounded-lg">Admin</a>
      <% } %>
      <div class="border-t border-slate-100 mt-2 pt-2">
        <a href="/logout" class="block px-3 py-2 text-sm text-red-500 hover:bg-red-50 rounded-lg">Log out</a>
      </div>
    <% } else { %>
      <a href="/pricing" class="block px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg">Pricing</a>
      <a href="/login" class="block px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg">Log in</a>
      <a href="/register" class="block px-3 py-2.5 text-sm text-center bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-lg font-medium mt-2">Sign up free</a>
    <% } %>
  </div>
</header>
