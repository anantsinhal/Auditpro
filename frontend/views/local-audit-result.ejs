<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <%
    const _isPdf = !(typeof isPdf === 'undefined' || !isPdf);
    const _assetBase = (typeof assetBaseUrl !== 'undefined' && assetBaseUrl) ? String(assetBaseUrl).replace(/\/+$/, '') : '';
    const _cssHref = _assetBase ? `${_assetBase}/css/style.css` : '/css/style.css';
    const _iconHref = _assetBase ? `${_assetBase}/favicon.svg` : '/favicon.svg';
  %>
  <% if (_isPdf && typeof pdfCss !== 'undefined' && pdfCss) { %>
    <style><%- pdfCss %></style>
  <% } else { %>
    <link rel="stylesheet" href="<%= _cssHref %>">
    <link rel="icon" type="image/svg+xml" href="<%= _iconHref %>">
  <% } %>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .section-open .section-body { display: block; }
    .section-body { display: none; }
    .chevron-btn svg { transition: transform 0.2s; }
    .chevron-btn.open svg { transform: rotate(180deg); }
    pre { white-space: pre-wrap; word-break: break-word; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
  <% if (typeof isPdf === 'undefined' || !isPdf) { %>
    <%- include('partials/header') %>
  <% } %>

  <%
    const raw     = audit.results || {};
    const rpt     = raw.report || {};
    const seo     = rpt.local_seo_analysis   || {};
    const comp    = rpt.competitor_gap        || {};
    const menu    = rpt.product_suggestions   || {};
    const reviews = rpt.review_insights       || {};
    const summary = rpt.simple_summary        || '';
    const plan    = rpt.action_plan           || {};
    const name    = rpt.restaurantName || 'Restaurant';
    const city    = rpt.city || '';
    const score   = audit.seo_score || audit.seoScore || 0;
    const createdAt = audit.created_at || audit.createdAt || new Date().toISOString();

    const highIssues   = (seo.issuesFound || []).filter(i => i.impact === 'High').length;
    const medIssues    = (seo.issuesFound || []).filter(i => i.impact === 'Medium').length;
    const scoreColor   = score >= 70 ? 'text-green-700 bg-green-100 ring-green-400' : score >= 50 ? 'text-amber-700 bg-amber-100 ring-amber-400' : 'text-red-700 bg-red-100 ring-red-400';
    const impactBadge  = (impact) => impact === 'High' ? 'bg-red-100 text-red-700' : impact === 'Medium' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600';
    const weekDots     = ['bg-red-500','bg-amber-500','bg-blue-500','bg-green-500'];
    const weeks = [
      { key: 'week1_days1to7',   label: 'Week 1 (Days 1–7)',   dot: weekDots[0] },
      { key: 'week2_days8to14',  label: 'Week 2 (Days 8–14)',  dot: weekDots[1] },
      { key: 'week3_days15to21', label: 'Week 3 (Days 15–21)', dot: weekDots[2] },
      { key: 'week4_days22to30', label: 'Week 4 (Days 22–30)', dot: weekDots[3] }
    ];
  %>

  <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">

    <!-- Back -->
    <% if (typeof isPdf === 'undefined' || !isPdf) { %>
    <div class="mb-6 flex justify-between items-center">
      <a href="/dashboard" class="text-indigo-600 hover:underline text-sm">← Dashboard</a>
      <div class="flex gap-3">
        <button onclick="emailReport()" class="bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700 transition-colors flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Email PDF
        </button>
        <a href="/local-audit/<%= audit.id %>/pdf" class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download PDF
        </a>
      </div>
    </div>
    <% } %>
    <div class="mb-6"><a href="/dashboard" class="text-indigo-600 hover:underline text-sm">← Dashboard</a></div>

    <!-- ── Header Banner ── -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6">
      <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
        <div class="w-24 h-24 shrink-0 rounded-full ring-4 ring-offset-2 flex flex-col items-center justify-center font-bold <%= scoreColor %>">
          <span class="text-2xl leading-none"><%= score %></span>
          <span class="text-xs opacity-60 mt-0.5">score</span>
        </div>
        <div class="flex-1 min-w-0">
          <span class="inline-flex items-center text-xs font-semibold bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded-full mb-2">🍽️ Restaurant &amp; Café Audit</span>
          <h1 class="text-xl font-bold text-slate-900"><%= name %></h1>
          <% if (city) { %><p class="text-slate-500 text-sm"><%= city %></p><% } %>
          <p class="text-slate-400 text-xs mt-1"><%= new Date(createdAt).toLocaleString() %></p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-red-100 text-red-700"><%= highIssues %> High Priority</span>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-amber-100 text-amber-700"><%= medIssues %> Medium Priority</span>
            <% if (seo.estimatedVisibilityImprovement) { %>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700">Visibility Potential: <%= seo.estimatedVisibilityImprovement.level %></span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- ── PART 1: Local SEO Analysis ── -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 mb-6 overflow-hidden">
      <button class="w-full flex items-center justify-between px-6 py-4 border-b border-slate-100 chevron-btn open" onclick="toggleSection(this)">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
          <span class="font-bold text-slate-900">Part 1 — Local SEO Analysis</span>
        </div>
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="section-body open p-6 space-y-6">

        <!-- Issues -->
        <% if (seo.issuesFound && seo.issuesFound.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">Issues Found (<%= seo.issuesFound.length %>)</h3>
          <div class="space-y-2">
            <% seo.issuesFound.forEach(function(issue) { %>
              <div class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="text-xs font-semibold px-2 py-0.5 rounded-md shrink-0 mt-0.5 <%= impactBadge(issue.impact) %>"><%= issue.impact %></span>
                <div>
                  <p class="text-sm font-medium text-slate-800"><%= issue.issue %></p>
                  <p class="text-xs text-slate-500 mt-0.5"><%= issue.category %></p>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Optimised Tags -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4">
            <p class="text-xs font-semibold text-indigo-500 uppercase tracking-wider mb-1">Optimised Title Tag</p>
            <p class="text-sm font-semibold text-indigo-900"><%= seo.optimisedTitle || '—' %></p>
          </div>
          <div class="bg-green-50 border border-green-200 rounded-xl p-4">
            <p class="text-xs font-semibold text-green-600 uppercase tracking-wider mb-1">Optimised Meta Description</p>
            <p class="text-sm text-green-900"><%= seo.optimisedMetaDescription || '—' %></p>
            <% if (seo.optimisedMetaDescription) { %><p class="text-xs text-green-600 mt-1"><%= seo.optimisedMetaDescription.length %> chars</p><% } %>
          </div>
        </div>

        <!-- Missing Keywords -->
        <% if (seo.missingLocalKeywords && seo.missingLocalKeywords.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-2">Missing Local Keywords to Target</h3>
          <div class="flex flex-wrap gap-2">
            <% seo.missingLocalKeywords.forEach(function(kw) { %>
              <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-xs font-medium"># <%= kw %></span>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- High Impact Improvements -->
        <% if (seo.highImpactImprovements && seo.highImpactImprovements.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">3 High-Impact Local Improvements</h3>
          <div class="space-y-3">
            <% seo.highImpactImprovements.forEach(function(imp, i) { %>
              <div class="border border-slate-200 rounded-xl p-4">
                <div class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full bg-indigo-600 text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5"><%= i+1 %></span>
                  <div>
                    <p class="text-sm font-semibold text-slate-900"><%= imp.improvement %></p>
                    <p class="text-sm text-slate-600 mt-1"><%= imp.detail %></p>
                    <span class="inline-block mt-1 text-xs font-medium px-2 py-0.5 rounded-full <%= impactBadge(imp.impact) %>">Impact: <%= imp.impact %></span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Visibility Estimate -->
        <% if (seo.estimatedVisibilityImprovement) { %>
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
          <p class="text-xs font-semibold text-amber-600 uppercase tracking-wider mb-1">Estimated Visibility Improvement</p>
          <p class="text-base font-bold text-amber-900"><%= seo.estimatedVisibilityImprovement.level %></p>
          <p class="text-sm text-amber-800 mt-1"><%= seo.estimatedVisibilityImprovement.explanation %></p>
        </div>
        <% } %>
      </div>
    </div>

    <!-- ── PART 2: Competitor Gap ── -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 mb-6 overflow-hidden">
      <button class="w-full flex items-center justify-between px-6 py-4 border-b border-slate-100 chevron-btn open" onclick="toggleSection(this)">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
          <span class="font-bold text-slate-900">Part 2 — Competitor Gap Analysis</span>
          <% if (comp.competitorName && comp.competitorName !== 'Competitor') { %>
            <span class="text-xs text-slate-500">vs <%= comp.competitorName %></span>
          <% } %>
        </div>
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="section-body open p-6 space-y-6">

        <!-- Gaps -->
        <% if (comp.areasWhereCompetitorIsStronger && comp.areasWhereCompetitorIsStronger.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">Where <%= comp.competitorName || 'Competitor' %> Is Stronger</h3>
          <div class="space-y-2">
            <% comp.areasWhereCompetitorIsStronger.forEach(function(gap) { %>
              <div class="border border-red-100 bg-red-50 rounded-xl p-4">
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class="text-sm font-semibold text-red-800"><%= gap.area %></span>
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= impactBadge(gap.impact) %>"><%= gap.impact %></span>
                </div>
                <div class="flex gap-4 text-xs text-slate-500 mb-1">
                  <span>You: <strong class="text-slate-700"><%= gap.yourValue %></strong></span>
                  <span><%= comp.competitorName %>: <strong class="text-slate-700"><%= gap.competitorValue %></strong></span>
                </div>
                <p class="text-sm text-red-700"><%= gap.insight %></p>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Strengths -->
        <% if (comp.areasWhereYouAreStronger && comp.areasWhereYouAreStronger.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">Your Strengths over <%= comp.competitorName || 'Competitor' %></h3>
          <div class="space-y-2">
            <% comp.areasWhereYouAreStronger.forEach(function(str) { %>
              <div class="border border-green-100 bg-green-50 rounded-xl p-3">
                <p class="text-sm font-medium text-green-800">✓ <%= str.area %></p>
                <p class="text-xs text-green-700 mt-0.5"><%= str.note %></p>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- 5 Actions to Outperform -->
        <% if (comp.fiveActionsToOutperform && comp.fiveActionsToOutperform.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">5 Practical Actions to Outperform Competitor</h3>
          <div class="space-y-3">
            <% comp.fiveActionsToOutperform.forEach(function(action) { %>
              <div class="border border-slate-200 rounded-xl p-4 flex gap-3">
                <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5"><%= action.priority %></span>
                <div>
                  <p class="text-sm font-semibold text-slate-900"><%= action.action %></p>
                  <p class="text-sm text-slate-600 mt-1"><%= action.detail %></p>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- ── PART 3: Menu Suggestions ── -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 mb-6 overflow-hidden">
      <button class="w-full flex items-center justify-between px-6 py-4 border-b border-slate-100 chevron-btn open" onclick="toggleSection(this)">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-teal-500"></span>
          <span class="font-bold text-slate-900">Part 3 — Menu & Product Suggestions</span>
        </div>
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="section-body open p-6 space-y-6">

        <!-- New Menu Items -->
        <% if (menu.fiveNewMenuItems && menu.fiveNewMenuItems.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">5 New Menu Items (Trending)</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% menu.fiveNewMenuItems.forEach(function(item) { %>
              <div class="border border-teal-100 bg-teal-50 rounded-xl p-4">
                <p class="text-sm font-bold text-teal-900"><%= item.name %></p>
                <p class="text-xs text-teal-700 mt-1"><%= item.description %></p>
                <% if (item.trend) { %><span class="inline-block mt-2 text-xs bg-teal-200 text-teal-800 rounded-full px-2 py-0.5">📈 <%= item.trend %></span><% } %>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- High Margin Items -->
        <% if (menu.threeHighMarginItems && menu.threeHighMarginItems.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">3 High-Margin Items</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <% menu.threeHighMarginItems.forEach(function(item) { %>
              <div class="border border-amber-100 bg-amber-50 rounded-xl p-4">
                <p class="text-sm font-bold text-amber-900"><%= item.name %></p>
                <p class="text-xs text-amber-700 mt-1"><%= item.description %></p>
                <span class="inline-block mt-2 text-xs bg-amber-200 text-amber-800 rounded-full px-2 py-0.5">Margin: <%= item.margin %></span>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Instagram Items -->
        <% if (menu.threeInstagramItems && menu.threeInstagramItems.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">3 Instagram-Worthy Items</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <% menu.threeInstagramItems.forEach(function(item) { %>
              <div class="border border-pink-100 bg-pink-50 rounded-xl p-4">
                <p class="text-sm font-bold text-pink-900"><%= item.name %></p>
                <p class="text-xs text-pink-700 mt-1"><%= item.description %></p>
                <% if (item.socialAngle) { %><span class="inline-block mt-2 text-xs bg-pink-200 text-pink-800 rounded-full px-2 py-0.5">📸 <%= item.socialAngle %></span><% } %>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Marketing Descriptions -->
        <% if (menu.marketingDescriptions && menu.marketingDescriptions.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">Ready-to-Use Marketing Descriptions</h3>
          <div class="space-y-4">
            <% menu.marketingDescriptions.forEach(function(m) { %>
              <div class="border border-slate-200 rounded-xl p-4 space-y-3">
                <p class="text-sm font-bold text-slate-900">🍽️ <%= m.itemName %></p>
                <div>
                  <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Menu Description</p>
                  <p class="text-sm text-slate-700 italic"><%= m.menuDescription %></p>
                </div>
                <div>
                  <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Social Media Caption</p>
                  <div class="relative">
                    <pre class="bg-slate-900 text-green-300 text-xs rounded-lg p-3"><code><%= m.socialMediaCaption %></code></pre>
                    <button onclick="copyCode(this)" class="absolute top-2 right-2 text-xs bg-slate-700 hover:bg-slate-600 text-white px-2 py-0.5 rounded transition-colors">Copy</button>
                  </div>
                </div>
                <div>
                  <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Google Business Post</p>
                  <div class="relative">
                    <pre class="bg-slate-900 text-blue-300 text-xs rounded-lg p-3"><code><%= m.googleBusinessPostText %></code></pre>
                    <button onclick="copyCode(this)" class="absolute top-2 right-2 text-xs bg-slate-700 hover:bg-slate-600 text-white px-2 py-0.5 rounded transition-colors">Copy</button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- ── PART 4: Review Intelligence ── -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 mb-6 overflow-hidden">
      <button class="w-full flex items-center justify-between px-6 py-4 border-b border-slate-100 chevron-btn open" onclick="toggleSection(this)">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span>
          <span class="font-bold text-slate-900">Part 4 — Review Intelligence</span>
          <% if (reviews.reviewCount > 0) { %><span class="text-xs text-slate-500"><%= reviews.reviewCount %> reviews analysed</span><% } %>
        </div>
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="section-body open p-6 space-y-6">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Praised -->
          <div class="bg-green-50 border border-green-100 rounded-xl p-4">
            <p class="text-xs font-semibold text-green-600 uppercase tracking-wider mb-2">Most Praised Aspects</p>
            <ul class="space-y-1">
              <% (reviews.mostPraisedAspects || []).forEach(function(a) { %>
                <li class="text-sm text-green-800 flex items-center gap-1.5">✓ <%= a %></li>
              <% }); %>
            </ul>
          </div>
          <!-- Complaints -->
          <div class="bg-red-50 border border-red-100 rounded-xl p-4">
            <p class="text-xs font-semibold text-red-600 uppercase tracking-wider mb-2">Most Common Complaints</p>
            <ul class="space-y-1">
              <% (reviews.mostCommonComplaints || []).forEach(function(c) { %>
                <li class="text-sm text-red-800 flex items-center gap-1.5">⚠ <%= c %></li>
              <% }); %>
            </ul>
          </div>
        </div>

        <!-- Operational Improvements -->
        <% if (reviews.operationalImprovements && reviews.operationalImprovements.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">Operational Improvements</h3>
          <div class="space-y-2">
            <% reviews.operationalImprovements.forEach(function(imp) { %>
              <div class="border border-slate-200 bg-slate-50 rounded-xl p-3 text-sm text-slate-700">⚙ <%= imp %></div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Negative Review Responses -->
        <% if (reviews.negativeReviewResponses && reviews.negativeReviewResponses.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">Professional Responses to Negative Reviews</h3>
          <div class="space-y-3">
            <% reviews.negativeReviewResponses.forEach(function(r) { %>
              <div class="border border-red-100 rounded-xl p-4">
                <p class="text-xs font-semibold text-red-500 mb-2">Scenario: <%= r.scenario %></p>
                <div class="relative">
                  <p class="text-sm text-slate-700 bg-slate-50 rounded-lg p-3 pr-16"><%= r.response %></p>
                  <button onclick="copyText(this, `<%= r.response.replace(/`/g,'').replace(/\n/g, ' ') %>`)" class="absolute top-2 right-2 text-xs bg-slate-200 hover:bg-slate-300 text-slate-700 px-2 py-0.5 rounded transition-colors">Copy</button>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- Positive Review Responses -->
        <% if (reviews.positiveReviewResponses && reviews.positiveReviewResponses.length > 0) { %>
        <div>
          <h3 class="text-sm font-semibold text-slate-700 mb-3">Engaging Responses to Positive Reviews</h3>
          <div class="space-y-3">
            <% reviews.positiveReviewResponses.forEach(function(r) { %>
              <div class="border border-green-100 rounded-xl p-4">
                <p class="text-xs font-semibold text-green-600 mb-2">Scenario: <%= r.scenario %></p>
                <div class="relative">
                  <p class="text-sm text-slate-700 bg-green-50 rounded-lg p-3 pr-16"><%= r.response %></p>
                  <button onclick="copyText(this, `<%= r.response.replace(/`/g,'').replace(/\n/g, ' ') %>`)" class="absolute top-2 right-2 text-xs bg-slate-200 hover:bg-slate-300 text-slate-700 px-2 py-0.5 rounded transition-colors">Copy</button>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- ── PART 5: Simple Summary ── -->
    <% if (summary) { %>
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 mb-6 overflow-hidden">
      <button class="w-full flex items-center justify-between px-6 py-4 border-b border-slate-100 chevron-btn open" onclick="toggleSection(this)">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
          <span class="font-bold text-slate-900">Part 5 — Simple Business Summary</span>
          <span class="text-xs text-slate-500">Plain English for business owners</span>
        </div>
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="section-body open">
        <div class="p-6">
          <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-5">
            <pre class="text-sm text-indigo-900 font-sans whitespace-pre-wrap leading-relaxed"><%= summary %></pre>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- ── PART 6: 30-Day Action Plan ── -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 mb-6 overflow-hidden">
      <button class="w-full flex items-center justify-between px-6 py-4 border-b border-slate-100 chevron-btn open" onclick="toggleSection(this)">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
          <span class="font-bold text-slate-900">Part 6 — 30-Day Action Plan</span>
        </div>
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="section-body open p-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <% weeks.forEach(function(week) {
            const weekData = plan[week.key] || {};
            const tasks = weekData.tasks || [];
          %>
          <div class="border border-slate-200 rounded-xl overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200">
              <div class="flex items-center gap-1.5 mb-1">
                <span class="w-2.5 h-2.5 rounded-full <%= week.dot %> shrink-0"></span>
                <span class="text-xs font-bold text-slate-700"><%= week.label %></span>
              </div>
              <p class="text-xs text-slate-500 leading-snug"><%= weekData.focus || '' %></p>
            </div>
            <ul class="divide-y divide-slate-100">
              <% tasks.forEach(function(task) { %>
                <li class="px-4 py-2.5 space-y-0.5">
                  <p class="text-xs text-slate-700 leading-snug font-medium"><%= task.task %></p>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-400"><%= task.timeRequired %></span>
                    <span class="text-xs font-medium px-1.5 py-0.5 rounded-full <%= impactBadge(task.impact) %>"><%= task.impact %></span>
                    <% if (task.cost === 'Free') { %><span class="text-xs text-green-600 font-medium">Free</span><% } %>
                  </div>
                </li>
              <% }); %>
              <% if (tasks.length === 0) { %><li class="px-4 py-3 text-xs text-slate-400 italic">No tasks.</li><% } %>
            </ul>
          </div>
          <% }); %>
        </div>
      </div>
    </div>

    

  </main>

  <% if (typeof isPdf === 'undefined' || !isPdf) { %>
    <%- include('partials/footer') %>
  <% } %>

  <script>
    function toggleSection(btn) {
      const card = btn.closest('.overflow-hidden');
      const body = card.querySelector('.section-body');
      body.classList.toggle('open');
      btn.classList.toggle('open');
    }

    function copyCode(btn) {
      const code = btn.previousElementSibling.querySelector('code').innerText;
      navigator.clipboard.writeText(code).then(() => {
        btn.textContent = '✓';
        setTimeout(() => btn.textContent = 'Copy', 2000);
      });
    }

    function copyText(btn, text) {
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = '✓';
        setTimeout(() => btn.textContent = 'Copy', 2000);
      });
    }

    function emailReport() {
      const btn = event.target.closest('button');
      const originalText = btn.innerHTML;
      btn.innerHTML = 'Sending...';
      btn.disabled = true;
      
      fetch('/local-audit/<%= audit.id %>/email', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          btn.innerHTML = 'Email Sent!';
          btn.classList.remove('bg-green-600', 'hover:bg-green-700');
          btn.classList.add('bg-green-500');
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
            btn.classList.remove('bg-green-500');
            btn.classList.add('bg-green-600', 'hover:bg-green-700');
          }, 3000);
        } else {
          btn.innerHTML = 'Failed';
          btn.classList.remove('bg-green-600', 'hover:bg-green-700');
          btn.classList.add('bg-red-500');
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
            btn.classList.remove('bg-red-500');
            btn.classList.add('bg-green-600', 'hover:bg-green-700');
          }, 3000);
        }
      })
      .catch(error => {
        console.error('Error:', error);
        btn.innerHTML = 'Failed';
        btn.classList.remove('bg-green-600', 'hover:bg-green-700');
        btn.classList.add('bg-red-500');
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.disabled = false;
          btn.classList.remove('bg-red-500');
          btn.classList.add('bg-green-600', 'hover:bg-green-700');
        }, 3000);
      });
    }  </script>
</body>
</html>
