<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
  <%- include('partials/header') %>
  <main class="max-w-2xl mx-auto px-4 py-8 flex-1 w-full">
    <h1 class="text-2xl font-bold text-slate-900 mb-6">Account Settings</h1>

    <!-- Flash Messages -->
    <% if (success) { %>
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 mb-6 flex items-center gap-3">
        <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <p class="text-green-800 text-sm">
          <% if (success === 'profile_updated') { %>Profile updated successfully.
          <% } else if (success === 'password_changed') { %>Password changed successfully.
          <% } else if (success === 'api_key_created') { %>API key created! Copy it now — it won't be shown again.
          <% } else if (success === 'api_key_revoked') { %>API key revoked.
          <% } else if (success === 'api_key_deleted') { %>API key deleted.
          <% } else { %><%= success %><% } %>
        </p>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6 flex items-center gap-3">
        <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <p class="text-red-800 text-sm">
          <% if (error === 'email_taken') { %>That email is already in use.
          <% } else if (error === 'wrong_password') { %>Incorrect password.
          <% } else if (error === 'password_short') { %>New password must be at least 6 characters.
          <% } else if (error === 'verification_send_failed') { %>Could not send verification email. Configure SMTP in <code>.env</code> (or check the server logs in development).
          <% } else { %><%= error %><% } %>
        </p>
      </div>
    <% } %>
    <% if (info) { %>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6 flex items-center gap-3">
        <svg class="w-5 h-5 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <p class="text-blue-800 text-sm">
          <% if (info === 'verification_sent') { %>Verification email sent! Check your inbox (and spam). If you're running locally without SMTP, check the server console for an Ethereal preview URL.
          <% } else if (info === 'already_verified') { %>Your email is already verified.
          <% } else { %><%= info %><% } %>
        </p>
      </div>
    <% } %>

    <!-- Email Verification Banner -->
    <% if (!user.email_verified) { %>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          <p class="text-amber-800 text-sm">Your email is not verified.</p>
        </div>
        <a href="/resend-verification" class="text-amber-700 underline text-sm font-medium hover:text-amber-900 shrink-0">Resend verification</a>
      </div>
    <% } %>

    <!-- Profile Section -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">Profile</h2>
      <form action="/settings/profile" method="post" class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Name</label>
          <input type="text" id="name" name="name" value="<%= user.name %>" required minlength="2" class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors">
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
          <input type="email" id="email" name="email" value="<%= user.email %>" required class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors">
          <% if (user.email_verified) { %>
            <p class="text-xs text-green-600 mt-1 flex items-center gap-1"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> Verified</p>
          <% } %>
        </div>
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors">Save changes</button>
      </form>
    </div>

    <!-- Change Password Section -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">Change Password</h2>
      <form action="/settings/password" method="post" class="space-y-4">
        <div>
          <label for="currentPassword" class="block text-sm font-medium text-slate-700 mb-1">Current Password</label>
          <input type="password" id="currentPassword" name="currentPassword" required class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors">
        </div>
        <div>
          <label for="newPassword" class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
          <input type="password" id="newPassword" name="newPassword" required minlength="6" class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors" placeholder="Min 6 characters">
        </div>
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors">Update password</button>
      </form>
    </div>

    <!-- Plan Info -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-slate-900 mb-2">Subscription</h2>
      <div class="flex items-center gap-3 mb-3">
        <span class="text-sm text-slate-600">Current plan:</span>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold <%= user.plan === 'pro' ? 'bg-gradient-to-r from-amber-100 to-orange-100 text-amber-800 border border-amber-200' : 'bg-slate-100 text-slate-600 border border-slate-200' %>">
          <%= user.plan === 'pro' ? '⭐ Pro' : 'Free' %>
        </span>
      </div>
      <p class="text-xs text-slate-500 mb-3">
        <% if (user.plan === 'pro') { %>You have unlimited audits and all premium features.
        <% } else { %>You have <%= Number.isFinite(freePlan?.monthlyAudits) ? freePlan.monthlyAudits : 'unlimited' %> free audits per month. Upgrade for unlimited access.<% } %>
      </p>
      <% if (user.plan === 'free') { %>
        <a href="/pricing" class="inline-block bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-all shadow-sm hover:shadow-md">Upgrade to Pro</a>
      <% } %>
    </div>

    <!-- API Keys Section -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-slate-900 mb-2">API Access</h2>
      <p class="text-xs text-slate-500 mb-4">Use API keys to access AuditPro programmatically. <code>POST /api/v1/audit</code>, <code>GET /api/v1/audits</code>, <code>GET /api/v1/audits/:id</code></p>

      <% if (typeof newKey !== 'undefined' && newKey) { %>
        <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 mb-4">
          <p class="text-sm font-semibold text-indigo-800 mb-1">Your new API key (copy it now):</p>
          <div class="flex items-center gap-2">
            <code id="api-key-display" class="flex-1 text-xs bg-white px-3 py-2 rounded border border-indigo-200 font-mono break-all select-all"><%= newKey %></code>
            <button onclick="navigator.clipboard.writeText(document.getElementById('api-key-display').textContent);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)" class="px-3 py-2 bg-indigo-600 text-white rounded-lg text-xs font-medium hover:bg-indigo-700 transition-colors shrink-0">Copy</button>
          </div>
          <p class="text-xs text-indigo-600 mt-2">⚠ This key will not be displayed again. Store it securely.</p>
        </div>
      <% } %>

      <% if (typeof apiKeys !== 'undefined' && apiKeys.length > 0) { %>
        <div class="space-y-2 mb-4">
          <% apiKeys.forEach(function(k) { %>
            <div class="flex items-center justify-between gap-3 p-3 bg-slate-50 rounded-lg border border-slate-100">
              <div class="min-w-0">
                <p class="text-sm font-medium text-slate-800"><%= k.name %></p>
                <p class="text-xs text-slate-400">Created: <%= new Date(k.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  <% if (k.last_used) { %> · Last used: <%= new Date(k.last_used).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% } %>
                </p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <% if (k.is_active) { %>
                  <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Active</span>
                  <form action="/settings/api-keys/<%= k.id %>/revoke" method="post" class="inline">
                    <button type="submit" class="px-2.5 py-1 text-xs font-medium bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-lg transition-colors">Revoke</button>
                  </form>
                <% } else { %>
                  <span class="px-2 py-0.5 text-xs font-medium bg-slate-100 text-slate-500 rounded-full">Revoked</span>
                <% } %>
                <form action="/settings/api-keys/<%= k.id %>/delete" method="post" class="inline" onsubmit="return confirm('Permanently delete this key?');">
                  <button type="submit" class="px-2.5 py-1 text-xs font-medium bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 rounded-lg transition-colors">Delete</button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <form action="/settings/api-keys" method="post" class="flex items-end gap-3">
        <div class="flex-1">
          <label for="keyName" class="block text-sm font-medium text-slate-700 mb-1">Key Name</label>
          <input type="text" id="keyName" name="name" value="Default" maxlength="100" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">
        </div>
        <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-700 text-sm transition-colors shrink-0">Generate Key</button>
      </form>
    </div>

    <!-- Danger Zone -->
    <div class="bg-white rounded-2xl border border-red-200 p-6">
      <h2 class="text-lg font-semibold text-red-700 mb-2">Danger Zone</h2>
      <p class="text-sm text-slate-500 mb-4">Permanently delete your account and all associated data. This action cannot be undone.</p>
      <button onclick="document.getElementById('delete-modal').classList.remove('hidden')" class="bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 px-5 py-2.5 rounded-lg text-sm font-medium transition-colors">Delete my account</button>
    </div>
  </main>

  <!-- Delete Account Modal -->
  <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-6 w-full max-w-sm">
      <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900 text-center mb-2">Delete Account</h3>
      <p class="text-sm text-slate-500 text-center mb-4">This will permanently delete your account, all audits, and all data. Enter your password to confirm.</p>
      <form action="/settings/delete-account" method="post" class="space-y-4">
        <div>
          <input type="password" name="confirmPassword" required placeholder="Enter your password" class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 bg-slate-50 focus:bg-white transition-colors">
        </div>
        <div class="flex gap-3">
          <button type="button" onclick="document.getElementById('delete-modal').classList.add('hidden')" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-lg font-medium text-sm transition-colors">Cancel</button>
          <button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 text-white py-2.5 rounded-lg font-medium text-sm transition-colors">Delete</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
