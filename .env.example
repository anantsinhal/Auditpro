# =============================================================
# AuditPro - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- Supabase (Database) ----
# Get your credentials from: https://app.supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key is required for server-side database operations (keep secret).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Used to sign the app's JWT session cookie.
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_EXPIRES_IN=7d

# ---- Server timeouts (optional) ----
# Helpful behind reverse proxies / load balancers.
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_HEADERS_TIMEOUT_MS=65000

# Timeout for auditing target sites (HTTP fetch)
AUDIT_REQUEST_TIMEOUT_MS=25000

# Allow auditing private/internal URLs (SSRF risk). Keep disabled in production.
ALLOW_PRIVATE_URLS=false

# ---- Razorpay (Payment Gateway) ----
# Sign up at https://dashboard.razorpay.com/ → Settings → API Keys
# Use test-mode keys for development (start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- App URL ----
APP_URL=http://localhost:3000

# ---- Plan limits (optional) ----
# Override defaults without changing code.
# Use a number (e.g. 5) or one of: unlimited, infinity
FREE_MONTHLY_AUDITS=2
FREE_SCHEDULED_AUDITS=1
FREE_BULK_KEYWORD_CHECKS=5

PRO_MONTHLY_AUDITS=unlimited
PRO_SCHEDULED_AUDITS=10
PRO_BULK_KEYWORD_CHECKS=unlimited

# ---- CORS (optional) ----
# Comma-separated list of allowed browser origins when calling this server from a different site.
# Examples:
#   CORS_ORIGINS=http://localhost:5173,http://localhost:3001
#   CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=

# If your browser sends `Origin: null` (e.g. opening frontend via file:// or sandboxed iframe),
# you can allow it in production by setting this to true. In development it's allowed by default.
CORS_ALLOW_NULL_ORIGIN=false

# ---- Email / SMTP (optional) ----
# Leave blank to auto-use Ethereal test emails in development.
# For production use Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Google APIs (optional) ----
# Used by the keyword ranking checker. Falls back to HTML scraping if missing.
# Get from: https://console.cloud.google.com → APIs → Custom Search JSON API
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ---- PageSpeed Insights API (optional) ----
# Used for Core Web Vitals data in audits. Works without a key (rate-limited).
# Get from: https://console.cloud.google.com → APIs → PageSpeed Insights API
PAGESPEED_API_KEY=

# ---- Gemini (AI insights) (optional) ----
# Used to generate AI-written recommendations in audit results.
GEMINI_API_KEY=

# Optional: override the default model (must be one returned by the ListModels endpoint).
# Examples: gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
